{
  "openapi": "3.1.0",
  "info": {
    "title": "Slopify API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": { "sessionToken": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "LibraryAlbum": {
        "type": "object",
        "required": [
          "id",
          "title",
          "artist",
          "release_year",
          "has_cover"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "release_year": {
            "type": "integer",
            "minimum": 1
          },
          "has_cover": {
            "type": "boolean"
          }
        }
      },
      "LibraryTrack": {
        "type": "object",
        "required": [
          "id",
          "title",
          "track_number"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "track_number": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "paths": {
    "/search": {
      "post": {
        "operationId": "searchTracks",
        "summary": "Search YouTube for tracks",
        "security": [{ "sessionToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 150 } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Up to 15 search results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "artist", "source"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
                      "title": { "type": "string" },
                      "artist": { "type": "string" },
                      "source": { "type": "string", "const": "YouTube" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Missing or expired session." },
          "404": { "description": "Search is disabled on this server." },
          "422": { "description": "Invalid search query." },
          "429": { "description": "Too many active searches." },
          "502": { "description": "YouTube or downloader request failed." },
          "503": { "description": "YouTube proxy is not configured or the downloader is busy." },
          "504": { "description": "Search timed out." }
        }
      }
    },
    "/search/youtube/{id}/audio": {
      "get": {
        "operationId": "playYouTubeTrack",
        "summary": "Get YouTube audio for playback from search",
        "security": [{ "sessionToken": [] }],
        "parameters": [{
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
        }],
        "responses": {
          "200": {
            "description": "The MP3 audio for a single playback request.",
            "content": { "audio/mpeg": { "schema": { "type": "string", "format": "binary" } } }
          },
          "401": { "description": "Missing or expired session." },
          "404": { "description": "Playback is disabled or the video has no downloadable audio." },
          "422": { "description": "Invalid video ID." },
          "429": { "description": "A playback request is already in progress." },
          "502": { "description": "YouTube or downloader request failed." },
          "503": { "description": "The downloader could not accept the request." },
          "504": { "description": "The playback request timed out." }
        }
      }
    },
    "/library/imports/youtube/{id}": {
      "put": {
        "operationId": "importYouTubeTrack",
        "summary": "Add one YouTube track to the shared library",
        "security": [{ "sessionToken": [] }],
        "parameters": [{
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
        }],
        "responses": {
          "200": {
            "description": "The track is already in the library.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LibraryAlbum" } } }
          },
          "201": {
            "description": "The track has been imported as a single.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LibraryAlbum" } } }
          },
          "401": { "description": "Missing or expired session." },
          "404": { "description": "Import is disabled or the video has no downloadable audio and cover." },
          "409": { "description": "A different release already uses this library location." },
          "422": { "description": "Invalid video ID." },
          "429": { "description": "An import is already in progress." },
          "502": { "description": "YouTube or downloader request failed." },
          "503": { "description": "The downloader could not accept the request." },
          "504": { "description": "The import timed out." }
        }
      }
    },
    "/library/albums": {
      "get": {
        "operationId": "listAlbums",
        "summary": "List library albums",
        "security": [
          {
            "sessionToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Entries in display order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LibraryAlbum"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token."
          }
        }
      }
    },
    "/library/albums/{id}/tracks": {
      "get": {
        "operationId": "listAlbumTracks",
        "summary": "List tracks on an album",
        "security": [
          {
            "sessionToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Album ID",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entries in display order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LibraryTrack"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token."
          },
          "404": {
            "description": "The entry or file is unavailable."
          }
        }
      }
    },
    "/library/albums/{id}/cover": {
      "get": {
        "operationId": "getAlbumCover",
        "summary": "Get the album cover",
        "security": [
          {
            "sessionToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Album ID",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Album cover.",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token."
          },
          "404": {
            "description": "The entry or file is unavailable."
          }
        }
      }
    },
    "/library/tracks/{id}/audio": {
      "get": {
        "operationId": "getTrackAudio",
        "summary": "Stream MP3 audio",
        "security": [
          {
            "sessionToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Track ID",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "Single byte range.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete MP3.",
            "headers": {
              "ETag": { "schema": { "type": "string" } },
              "Accept-Ranges": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token."
          },
          "206": {
            "description": "Requested bytes.",
            "headers": {
              "ETag": { "schema": { "type": "string" } },
              "Content-Range": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "The entry or file is unavailable."
          },
          "416": {
            "description": "Range outside the file.",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "getTrackAudioMetadata",
        "summary": "Get MP3 length and range support",
        "security": [
          {
            "sessionToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Track ID",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audio headers.",
            "headers": {
              "ETag": { "schema": { "type": "string" } },
              "Content-Length": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token."
          },
          "404": {
            "description": "The entry or file is unavailable."
          }
        }
      }
    },
    "/session": {
      "post": {
        "operationId": "login",
        "summary": "Start a seven-day session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "is_admin"
                  ],
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "is_admin": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "429": {
            "description": "Password verification capacity reached."
          },
          "422": {
            "description": "Invalid fields."
          }
        }
      },
      "get": {
        "operationId": "currentSession",
        "summary": "Get the signed-in username",
        "security": [
          {
            "sessionToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "username"
                  ],
                  "properties": {
                    "username": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token."
          }
        }
      },
      "delete": {
        "operationId": "logout",
        "summary": "Revoke this session",
        "security": [
          {
            "sessionToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session ended."
          },
          "401": {
            "description": "Missing or malformed token."
          }
        }
      }
    },
    "/setup": {
      "get": {
        "operationId": "getSetupStatus",
        "summary": "Check whether the first administrator can be registered",
        "responses": {
          "200": {
            "description": "Current setup state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "registration_required"
                  ],
                  "properties": {
                    "registration_required": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Database error."
          }
        }
      },
      "post": {
        "operationId": "registerFirstAdmin",
        "summary": "Create the first administrator using the one-time setup code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password",
                  "code"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "No control characters or surrounding whitespace."
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 15,
                    "maxLength": 128,
                    "writeOnly": true
                  },
                  "code": {
                    "type": "string",
                    "format": "uuid",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Administrator created."
          },
          "400": {
            "description": "Invalid JSON."
          },
          "403": {
            "description": "Incorrect setup code."
          },
          "409": {
            "description": "Setup already completed."
          },
          "413": {
            "description": "Body exceeds 4096 bytes."
          },
          "415": {
            "description": "Expected application/json."
          },
          "422": {
            "description": "Invalid fields."
          },
          "429": { "description": "Password hashing capacity reached." },
          "500": {
            "description": "Registration failed."
          }
        }
      }
    },
    "/invitations": {
      "post": {
        "operationId": "createInvitation",
        "summary": "Create a one-time invitation valid for 24 hours",
        "security": [{ "sessionToken": [] }],
        "responses": {
          "201": {
            "description": "Invitation created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": { "code": { "type": "string", "format": "uuid" } }
                }
              }
            }
          },
          "401": { "description": "Missing, expired or invalid token." },
          "403": { "description": "Administrator role required." }
        }
      }
    },
    "/accounts": {
      "post": {
        "operationId": "registerInvitedAccount",
        "summary": "Register a regular account using an invitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["username", "password", "code"],
                "properties": {
                  "username": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "password": { "type": "string", "format": "password", "minLength": 15, "maxLength": 128 },
                  "code": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created and invitation consumed." },
          "400": { "description": "Invalid JSON." },
          "403": { "description": "Invalid, expired or already used invitation." },
          "409": { "description": "Username already taken. The invitation remains valid." },
          "413": { "description": "Body exceeds 4096 bytes." },
          "415": { "description": "Expected application/json." },
          "422": { "description": "Invalid fields." },
          "429": { "description": "Password hashing capacity reached." }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Check server readiness",
        "responses": {
          "200": { "description": "PostgreSQL is reachable." },
          "503": { "description": "PostgreSQL is unavailable." }
        }
      }
    }
  }
}
